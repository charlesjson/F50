{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UFI Panel Linux",
  "version": "0.5.16",
  "identifier": "io.ufi.panel.linux",
  "build": {
    "frontendDist": "../build/tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "../assets/icon.png"
    ],
    "resources": {
      "../src/backend.cjs": "backend/backend.cjs",
      "../src/worker.cjs": "backend/worker.cjs",
      "../src/core/": "backend/core/"
    }
  }
}
